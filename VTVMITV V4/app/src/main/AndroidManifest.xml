<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.vtvmitv">

    <!-- Quyền kết nối mạng xem luồng trực tiếp & tải dữ liệu M3U -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Quyền đồng bộ hàng kênh trên Android TV Home / Projectivy Launcher -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Quyền tự động cài đặt file APK kho ứng dụng trực tiếp trên TV -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Khai báo cấu hình Leanback chuẩn Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_app_mitv"
        android:label="@string/app_name"
        android:banner="@drawable/ic_banner_mitv"
        android:supportsRtl="true"
        android:theme="@style/Theme.VTVMITV"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:colorMode="wideColorGamut"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">

            <!-- Điểm khởi chạy Launcher cho Android TV & Mobile -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Bộ lọc nhận lệnh Deep Link mở trực tiếp kênh từ ngoài Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="play"
                    android:scheme="vtvmitv" />
            </intent-filter>

            <!-- Bộ lọc tìm kiếm giọng nói toàn hệ thống Android TV / Google Assistant -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- Provider cung cấp kết quả gợi ý tìm kiếm giọng nói chuẩn Leanback -->
        <provider
            android:name=".VoiceSuggestionProvider"
            android:authorities="com.xiaomi.vtvmitv.suggest"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- FileProvider cấp quyền cài đặt file APK kho ứng dụng TV -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.xiaomi.vtvmitv.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>