<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.vtvmitv">

    <!-- Quyền kết nối mạng xem luồng trực tiếp & tải dữ liệu M3U -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Quyền đồng bộ hàng kênh trên Android TV Home / Projectivy Launcher -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Quyền tự động cài đặt file APK kho ứng dụng trực tiếp trên TV -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Quyền thu âm trực tiếp từ Remote/Micro TV khi bấm phím Voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Khai báo truy vấn các ứng dụng YouTube / SmartTube trên Android TV (Bắt buộc từ Android 11+) -->
    <queries>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.videomanager" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>

    <!-- Khai báo cấu hình Leanback chuẩn Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_app_mitv"
        android:label="@string/app_name"
        android:banner="@drawable/ic_banner_mitv"
        android:supportsRtl="true"
        android:theme="@style/Theme.VTVMITV"
        android:usesCleartextTraffic="true">

        <!-- MÀN HÌNH CHÍNH XEM TRUYỀN HÌNH IPTV -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:colorMode="wideColorGamut"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.xiaomi.vtvmitv"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">

            <!-- Điểm khởi chạy Launcher cho Android TV & Mobile -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Nhận lệnh Deep Link mở thẳng kênh (Hỗ trợ cả vtvmitv://play và vtvmitv://*) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vtvmitv" />
            </intent-filter>

            <!-- Nhận lệnh tìm kiếm & phát từ các nguồn hệ thống -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- THANH LẮNG NGHE GIỌNG NÓI NỔI -->
        <!-- Đổi launchMode sang singleTop để cùng taskAffinity với MainActivity, cho phép startActivity lôi MainActivity lên ngay lập tức -->
        <activity
            android:name=".VoiceDialogActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.xiaomi.vtvmitv"
            android:excludeFromRecents="true">
            <!-- Đón phím Voice / Assist trên Remote TV -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <action android:name="com.xiaomi.vtvmitv.ACTION_LISTEN_VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Dịch vụ Voice Assistant độc lập để TV đăng ký làm Trợ lý mặc định -->
        <service
            android:name=".TvVoiceInteractionService"
            android:label="Trợ Lý VTV MITV"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".TvVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- Provider cung cấp kết quả gợi ý tìm kiếm giọng nói chuẩn Leanback -->
        <provider
            android:name=".VoiceSuggestionProvider"
            android:authorities="com.xiaomi.vtvmitv.suggest"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- FileProvider cấp quyền cài đặt file APK kho ứng dụng TV -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.xiaomi.vtvmitv.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>